{
    "name": "well-rested/openapi-model",
    "description": "DTO classes to represent OpenApi Schema 3.1.X",
    "keywords": [
        "openapi",
        "swagger",
        "php"
    ],
    "homepage": "https://github.com/well-rested/openapi-model",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "scripts": {
        "test": "./vendor/bin/phpunit --no-coverage",
        "coverage": "./vendor/bin/phpunit --coverage-text",
        "coverage-html": "./vendor/bin/phpunit --coverage-html docs/coverage",
        "coverage-check": "./vendor/bin/phpunit --coverage-clover build/coverage.xml && php scripts/check-coverage.php",
        "coverage-badge": "./vendor/bin/phpunit --coverage-clover build/coverage.xml && php scripts/generate-coverage-badge.php",
        "csfix": "./vendor/bin/php-cs-fixer fix --config .php-cs-fixer.php src tests",
        "csfix-dry-run": "./vendor/bin/php-cs-fixer fix --config .php-cs-fixer.php --dry-run src tests",
        "stan": "./vendor/bin/phpstan analyse -c phpstan.neon --memory-limit 512M",
        "lint": [
            "@csfix-dry-run",
            "@stan"
        ]
    },
    "autoload": {
        "psr-4": {
            "OpenApiSchema\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Adam Kirk",
            "email": "adam_kirk@live.co.uk",
            "homepage": "https://github.com/adamkirk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "symfony/var-dumper": "^8.0"
    }
}
